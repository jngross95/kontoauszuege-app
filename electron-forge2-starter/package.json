{
  "name": "electron-forge2-starter",
  "version": "0.1.0",
  "productName": "Kontoauszuege",
  "description": "Kontoauszüge desktop application built with Electron",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-flatpak": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "electron": "^43.2.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "executableName": "electron-forge2-starter"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-flatpak",
          "config": {}
        }
      ]
    }
  }
}
