{
  "name": "kontoauszuege-electron-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Electron starter that launches the Spring Boot app and shows a splash screen while it starts.",
  "main": "main.js",
  "type": "commonjs",
  "author": "",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:all": "electron-builder --linux AppImage --win nsis --mac dmg"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.example.kontoauszuege",
    "productName": "Kontoauszuege",
    "icon": "icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/*/{README,README.md,readme.md}"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "spring-boot-app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
