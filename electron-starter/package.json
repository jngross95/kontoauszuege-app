{
  "name": "kontoauszuege-electron-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Electron starter that launches the Spring Boot app and shows a splash screen while it starts.",
  "main": "main.js",
  "type": "commonjs",
  "author": "",
  "homepage": "https://example.com/kontoauszuege",
  "desktopName": "com.example.kontoauszuege",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:linux:deb": "electron-builder --linux deb",
    "dist:linux:flatpak": "export DEBUG=\"@malept/flatpak-bundler\"&&rm -rf \"$HOME/.cache/electron-builder\" /tmp/flatpak-bundler-* && PATH=\"$PWD/bin:$PATH\" electron-builder --linux flatpak",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:all": "electron-builder --linux AppImage --win nsis --mac dmg"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7"
  },
  "build": {
    "appId": "com.example.kontoauszuege",
    "productName": "Kontoauszuege",
    "icon": "icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/*/{README,README.md,readme.md}"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "spring-boot-app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "flatpak"
      ],
      "category": "Utility",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "deb": {
      "maintainer": "Kontoauszuege Team <noreply@example.com>",
      "depends": [
        "libgtk-3-0"
      ],
      "priority": "optional"
    },
    "flatpak": {
      "branch": "stable",
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "files": [
        ["com.example.kontoauszuege.metainfo.xml", "/app/share/metainfo/com.example.kontoauszuege.metainfo.xml"]
      ],
      "finishArgs": [
        "--socket=wayland",
        "--socket=x11",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--socket=session-bus",
        "--filesystem=home",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications",
        "--own-name=com.example.kontoauszuege"
      ]
    }
  }
}
